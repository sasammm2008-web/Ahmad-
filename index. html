/* التنقل بين الموقع والأدمن */
function showRoute(){
  if(recoveryMode) return;

  const admin = location.hash === '#admin';
  $('publicView').classList.toggle('hidden',admin);
  $('adminView').classList.toggle('active',admin);

  if(admin){
    sb.auth.getSession().then(({data,error}) => {
      if(location.hash !== '#admin' || recoveryMode) return;
      if(error){
        showLogin(error.message);
        return;
      }
      checkAdmin(data.session?.user);
    });
  }else{
    dashboardLoaded = false;
  }
}
window.addEventListener('hashchange',showRoute);

/* أنيميشن الظهور */
function setupReveal(){
  const targets = document.querySelectorAll(
    '.hero>div,.section-head,.service,.vip-inner,.gallery-tile,.booking-info,.form-card'
  );

  if(!('IntersectionObserver' in window)){
    targets.forEach(el => el.classList.add('is-visible'));
    return;
  }

  const observer = new IntersectionObserver(entries => {
    entries.forEach(entry => {
      if(entry.isIntersecting){
        entry.target.classList.add('is-visible');
        observer.unobserve(entry.target);
      }
    });
  },{threshold:.12});

  targets.forEach((el,index) => {
    el.classList.add('reveal');
    if(el.classList.contains('service') || el.classList.contains('gallery-tile')){
      el.style.transitionDelay = `${(index % 4) * 80}ms`;
    }
    observer.observe(el);
  });
}

/* تشغيل الموقع */
async function startSite(){
  $('year').textContent = new Date().getFullYear();

  const today = new Date();
  const localDate = new Date(today.getTime() - today.getTimezoneOffset()*60000)
    .toISOString().split('T')[0];
  $('date').min = localDate;

  renderServices();
  renderGallery();

  try{
    await syncPublicData();
    await loadOffers();

    const {data,error} = await sb.from('site_settings')
      .select('setting_value')
      .eq('setting_key','page_content')
      .maybeSingle();

    if(!error && data?.setting_value){
      applyPageContent(data.setting_value);
    }
  }catch(err){
    console.error('Site loading error:',err);
  }

  setupReveal();

  setTimeout(() => $('intro').classList.add('hide'),3000);

  showRoute();

  if(new URLSearchParams(location.search).get('recovery') === '1'){
    $('intro').classList.add('hide');
  }
}

startSite();
