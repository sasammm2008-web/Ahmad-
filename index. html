/* إدارة الخدمات */
async function renderAdminServices(){
  const {data,error} = await sb.from('services').select('*').order('sort_order');
  if(error){$('adminServices').textContent = error.message;return;}

  $('adminServices').innerHTML = `
    <table class="admin-table">
      <thead><tr><th>الخدمة</th><th>السعر</th><th>الخصم</th><th>حفظ</th><th>حذف</th></tr></thead>
      <tbody>${(data || []).map(s => `
        <tr>
          <td>${esc(s.name)}</td>
          <td><input id="price-${s.id}" type="text" value="${esc(s.price)}"></td>
          <td><input id="discount-${s.id}" type="number" min="0" value="${esc(s.discount_price ?? '')}"></td>
          <td><button class="btn small" onclick="updateService('${s.id}')">حفظ</button></td>
          <td><button class="btn dark small" onclick="deleteService('${s.id}')">حذف</button></td>
        </tr>`).join('')}
      </tbody>
    </table>`;
}

async function updateService(id){
  const price = $('price-'+id).value.trim();
  const raw = $('discount-'+id).value;
  const discount = raw === '' ? null : Number(raw);

  if(!price){
    alert('اكتب السعر.');
    return;
  }

  if(discount !== null && (!Number.isFinite(discount) || discount < 0)){
    alert('راجع قيمة الخصم.');
    return;
  }

  const numericOriginal = Number(price);
  const hasNumericOriginal = price !== '' && Number.isFinite(numericOriginal) && numericOriginal >= 0;

  if(discount !== null && !hasNumericOriginal){
    alert('لا يمكن وضع خصم على خدمة سعرها نص مثل "يحدد بالصالون". اكتب السعر الأصلي بالأرقام أو امسح الخصم.');
    return;
  }

  if(discount !== null && discount >= numericOriginal){
    alert('السعر بعد الخصم يجب أن يكون أقل من السعر الأصلي.');
    return;
  }

  const {error} = await sb.from('services').update({
    price:String(price),discount_price:discount
  }).eq('id',id);

  if(error){alert(error.message);return;}
  await renderAdminServices();
  await syncPublicData();
  alert('تم حفظ السعر.');
}

async function deleteService(id){
  if(!confirm('هل تريد حذف الخدمة؟')) return;
  const {error} = await sb.from('services').delete().eq('id',id);
  if(error){alert(error.message);return;}
  await renderAdminServices();
  await syncPublicData();
}

