/* نموذج الحجز */
$('bookingForm').addEventListener('submit',async e => {
  e.preventDefault();

  const button = e.submitter || e.target.querySelector('button[type="submit"]');
  const notice = $('bookingNotice');

  const selectedServices = getSelectedServices();
  const serviceNames = selectedServices.map(s => s.name);
  const serviceText = serviceNames.join('، ');

  if(!selectedServices.length){
    alert('اختار خدمة واحدة على الأقل.');
    return;
  }

  let knownTotal = 0;
  let totalSaving = 0;
  let unknownCount = 0;

  const serviceDetails = selectedServices.map(service => {
    const pricing = getServicePricing(service);

    if(pricing.final === null){
      unknownCount++;
      return `${service.name}: السعر يحدد بالصالون`;
    }

    knownTotal += pricing.final;
    totalSaving += pricing.saving;

    if(pricing.hasDiscount){
      return `${service.name}: الأصلي ${money(pricing.original)} جنيه، بعد الخصم ${money(pricing.final)} جنيه، التوفير ${money(pricing.saving)} جنيه`;
    }

    return `${service.name}: ${money(pricing.final)} جنيه`;
  });

  const totalText = unknownCount
    ? `الإجمالي المبدئي: ${money(knownTotal)} جنيه (يوجد ${unknownCount} خدمة سعرها يحدد بالصالون)`
    : `الإجمالي النهائي: ${money(knownTotal)} جنيه`;

  const order = {
    customer:$('customer').value.trim(),
    phone:$('phone').value.trim(),
    services:serviceNames,
    date:$('date').value,
    time:$('time').value,
    payment:$('payment').value,
    notes:$('notes').value.trim()
  };

  if(!order.customer || !order.phone || !order.services.length ||
     !order.date || !order.time || !order.payment){
    alert('من فضلك أكمل البيانات المطلوبة واختار خدمة واحدة على الأقل.');
    return;
  }

  button.disabled = true;
  notice.style.display = 'block';
  notice.textContent = 'جاري تسجيل الحجز...';

  try{
    const {error} = await sb.from('bookings').insert({
      customer_name:order.customer,
      phone:order.phone,
      service_name:serviceText,
      booking_date:order.date,
      booking_time:order.time,
      payment_method:order.payment,
      notes:order.notes,
      status:'بانتظار التأكيد'
    });

    if(error) throw error;

    notice.textContent = 'تم تسجيل الحجز بنجاح. ' + totalText;

    const message = [
      'طلب حجز جديد - صالون أحمد فريد',
      'الاسم: '+order.customer,
      'الهاتف: '+order.phone,
      '',
      'تفاصيل الخدمات:',
      ...serviceDetails,
      '',
      totalText,
      totalSaving > 0 ? `إجمالي التوفير: ${money(totalSaving)} جنيه` : '',
      'التاريخ: '+order.date,
      'الوقت: '+order.time,
      'الدفع: '+order.payment,
      'ملاحظات: '+(order.notes || 'لا يوجد')
    ].filter(Boolean).join('\n');

    window.open(
      'https://wa.me/'+whatsapp+'?text='+encodeURIComponent(message),
      '_blank'
    );

    e.target.reset();
    updateSelectedServices();

  }catch(err){
    notice.textContent = 'تعذر تسجيل الحجز: '+err.message;
  }finally{
    button.disabled = false;
  }
});

/* نظام تسجيل الدخول والاستعادة */
function showLogin(message=''){
  dashboardLoaded = false;
  $('dashboard').style.display = 'none';
  $('loginBox').style.display = 'block';
  $('loginForm').style.display = 'block';
  $('resetPasswordForm').style.display = 'none';
  if(message) showMessage($('loginError'),message);
}

function showDashboard(){
  $('loginBox').style.display = 'none';
  $('dashboard').style.display = 'block';

  if(dashboardLoaded) return;
  dashboardLoaded = true;

  Promise.all([
    loadAdminOrders(),
    renderAdminServices(),
    renderAdminGallery(),
    loadOffers(),
    loadPageEditor()
  ]).catch(err => {
    console.error('Admin loading:',err);
    alert('تعذر تحميل لوحة الإدارة: '+err.message);
  });
}

function checkAdmin(user){
  if(user?.app_metadata?.role === 'admin'){
    showDashboard();
    return true;
  }
  showLogin('الحساب لا يمتلك صلاحية الإدارة. يجب تعيين role = admin في Supabase.');
  return false;
}

$('loginForm').addEventListener('submit',async e => {
  e.preventDefault();
  const button = $('loginButton');
  button.disabled = true;
  button.textContent = 'جاري التحقق...';
  showMessage($('loginError'),'');
  try{
    const {data,error} = await sb.auth.signInWithPassword({
      email:$('adminEmail').value.trim(),
      password:$('adminPassword').value
    });

    if(error){
      if(error.message.toLowerCase().includes('invalid login credentials')){
        throw new Error('الإيميل أو كلمة المرور غير صحيحة. اضغط «نسيت كلمة المرور؟» لتعيين كلمة مرور جديدة.');
      }
      throw error;
    }

    if(data.user?.app_metadata?.role !== 'admin'){
      await sb.auth.signOut();
      throw new Error('تم تسجيل الدخول لكن الحساب ليس لديه صلاحية الأدمن.');
    }

    showDashboard();
  }catch(err){
    showMessage($('loginError'),err.message);
  }finally{
    button.disabled = false;
    button.textContent = 'دخول لوحة التحكم';
  }
});

/* إرسال رابط استعادة كلمة المرور */
$('forgotPassword').addEventListener('click',async () => {
  const email = $('adminEmail').value.trim();

  if(!email){
    showMessage($('loginError'),'اكتب الإيميل الأول ثم اضغط نسيت كلمة المرور.');
    $('adminEmail').focus();
    return;
  }

  const button = $('forgotPassword');
  button.disabled = true;
  button.textContent = 'جاري إرسال الرابط...';

  try{
    const redirectUrl = location.origin + location.pathname + '?recovery=1';
    const {error} = await sb.auth.resetPasswordForEmail(email,{
      redirectTo:redirectUrl
    });
    if(error) throw error;

    showMessage($('loginError'),'تم طلب إرسال رابط الاستعادة. راجع البريد الوارد والرسائل غير المرغوب فيها.');
  }catch(err){
    showMessage($('loginError'),'تعذر إرسال الرابط: '+err.message);
  }finally{
    button.disabled = false;
    button.textContent = 'نسيت كلمة المرور؟';
  }
});

/* فتح نموذج كلمة المرور الجديدة */
function showPasswordRecovery(){
  recoveryMode = true;
  $('publicView').classList.add('hidden');
  $('adminView').classList.add('active');
  $('loginBox').style.display = 'block';
  $('dashboard').style.display = 'none';
  $('loginForm').style.display = 'none';
  $('resetPasswordForm').style.display = 'block';
  showMessage($('loginError'),'اكتب كلمة المرور الجديدة مرتين.');
}

/* حفظ كلمة المرور الجديدة */
$('resetPasswordForm').addEventListener('submit',async e => {
  e.preventDefault();

  const password = $('newPassword').value;
  const confirmPassword = $('confirmPassword').value;

  if(password.length < 8){
    showMessage($('loginError'),'كلمة المرور يجب ألا تقل عن 8 أحرف.');
    return;
  }
  if(password !== confirmPassword){
    showMessage($('loginError'),'كلمتا المرور غير متطابقتين.');
    return;
  }

  const button = e.submitter;
  button.disabled = true;
  button.textContent = 'جاري الحفظ...';

  try{
    const {data,error} = await sb.auth.updateUser({password});
    if(error) throw error;

    recoveryMode = false;
    $('newPassword').value = '';
    $('confirmPassword').value = '';

    if(data.user?.app_metadata?.role === 'admin'){
      showDashboard();
      showMessage($('loginError'),'تم تغيير كلمة المرور بنجاح.');
    }else{
      showLogin('تم تغيير كلمة المرور، لكن الحساب لا يمتلك صلاحية الأدمن.');
    }
  }catch(err){
    showMessage($('loginError'),'تعذر تغيير كلمة المرور: '+err.message);
  }finally{
    button.disabled = false;
    button.textContent = 'حفظ كلمة المرور الجديدة';
  }
});

/* الخروج */
$('logout').addEventListener('click',async () => {
  const {error} = await sb.auth.signOut();
  if(error){alert(error.message);return;}
  recoveryMode = false;
  dashboardLoaded = false;
  $('adminPassword').value = '';
  location.hash = 'home';
  showLogin();
});

/* متابعة أحداث المصادقة */
sb.auth.onAuthStateChange((event,session) => {
  if(event === 'PASSWORD_RECOVERY'){
    showPasswordRecovery();
    return;
  }

  if(location.hash === '#admin' && !recoveryMode){
    if(session?.user?.app_metadata?.role === 'admin'){
      showDashboard();
    }else{
      showLogin();
    }
  }
});

