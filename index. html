/* إضافة صورة للمعرض */
$('galleryForm').addEventListener('submit',async e => {
  e.preventDefault();

  const button = e.submitter || e.target.querySelector('button[type="submit"]');
  const file = $('galleryFile').files[0];
  const description = $('galleryDescription').value.trim();
  const priceRaw = $('galleryPrice').value;
  const discountRaw = $('galleryDiscount').value;

  const price = priceRaw === '' ? null : Number(priceRaw);
  const discount = discountRaw === '' ? null : Number(discountRaw);

  if(!file){alert('اختار الصورة الأول.');return;}

  if((price !== null && (!Number.isFinite(price) || price < 0)) ||
     (discount !== null && (!Number.isFinite(discount) || discount < 0))){
    alert('راجع الأسعار المدخلة.');
    return;
  }

  if(price !== null && discount !== null && discount >= price){
    alert('السعر بعد الخصم يجب أن يكون أقل من السعر الأصلي.');
    return;
  }

  if(price === null && discount !== null){
    alert('لا يمكن إضافة سعر خصم بدون سعر أصلي.');
    return;
  }

  button.disabled = true;
  button.textContent = 'جاري رفع الصورة...';

  try{
    const image = await uploadImage(file,'gallery');

    const {error} = await sb.from('gallery').insert({
      title:'صورة من المعرض',
      image_url:image,
      price:price,
      discountprice:discount,
      description:description,
      is_active:true,
      sort_order:gallery.length
    });

    if(error) throw error;

    e.target.reset();
    await renderAdminGallery();
    await syncPublicData();
    alert('تم رفع الصورة بنجاح.');
  }catch(err){
    alert('حصل خطأ أثناء رفع الصورة: '+err.message);
  }finally{
    button.disabled = false;
    button.textContent = 'رفع الصورة';
  }
});

