          <div class="service-price-box">${priceHTML}</div>
        </div>
      </label>`;
  }).join('');

  updateSelectedServices();
}

/* جلب الخدمات المختارة */
function getSelectedServices(){
  return [...document.querySelectorAll('.service-checkbox:checked')]
    .map(input => services[Number(input.dataset.index)])
    .filter(Boolean);
}

/* حساب وعرض الإجمالي والتفاصيل */
function updateSelectedServices(){
  const selected = getSelectedServices();
  const totalElement = $('selectedTotal');

  if(!totalElement) return;

  if(!selected.length){
    totalElement.innerHTML = 'لم يتم اختيار أي خدمة حتى الآن';
    return;
  }

  let total = 0;
  let totalSaving = 0;
  let unknownCount = 0;

  const rows = selected.map(service => {
    const pricing = getServicePricing(service);

    if(pricing.final === null){
      unknownCount++;

      return `
        <div class="selected-breakdown-row">
          <span>${esc(service.name)}</span>
          <small>يحدد بالصالون</small>
        </div>`;
    }

    total += pricing.final;
    totalSaving += pricing.saving;

    let priceLabel = '';

    if(pricing.hasDiscount){
      priceLabel = `
        <span>
          <del class="service-old-price">${money(pricing.original)} ج</del>
          <strong class="service-new-price">${money(pricing.final)} ج</strong>
        </span>`;
    }else{
      priceLabel = `<strong>${money(pricing.final)} ج</strong>`;
    }

    return `
      <div class="selected-breakdown-row">
        <span>${esc(service.name)}</span>
        ${priceLabel}
      </div>`;
  }).join('');

  totalElement.innerHTML = `
    <div>عدد الخدمات المختارة: ${selected.length}</div>

    <div class="selected-breakdown">
      ${rows}
    </div>

    <div style="display:flex;justify-content:space-between;gap:8px;margin-top:12px">
      <span>الإجمالي ${unknownCount ? 'المبدئي' : 'النهائي'}</span>
      <strong>${money(total)} جنيه</strong>
    </div>

    ${totalSaving > 0 ? `
      <div class="selected-saving-total">
        إجمالي التوفير: ${money(totalSaving)} جنيه
      </div>` : ''}

    ${unknownCount ? `
      <div class="selected-unknown">
        يوجد ${unknownCount} خدمة سعرها يحدد بالصالون، لذلك الإجمالي المعروض مبدئي.
      </div>` : ''}
  `;
}

