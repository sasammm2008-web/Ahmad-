async function uploadImage(file,prefix){
  if(!file || !file.type.startsWith('image/')) throw new Error('اختار صورة صحيحة.');
  if(file.size > 8*1024*1024) throw new Error('حجم الصورة يجب ألا يتجاوز 8 ميجابايت.');

  const name = file.name.replace(/[^a-zA-Z0-9._-]/g,'_');
  const path = `${prefix}-${Date.now()}-${name}`;
  const {error} = await sb.storage.from(bucket).upload(path,file,{
    contentType:file.type,upsert:false
  });
  if(error) throw error;

  const {data} = sb.storage.from(bucket).getPublicUrl(path);
  return data.publicUrl;
}

/* حساب السعر الأصلي والخصم والسعر النهائي */
function getServicePricing(service){
  const rawOriginal = service?.price;

  const original = rawOriginal === null ||
    rawOriginal === undefined ||
    rawOriginal === ''
      ? null
      : Number(rawOriginal);

  const hasOriginal = Number.isFinite(original) && original >= 0;

  const rawDiscount = service?.discount_price;

  const discount = rawDiscount === null ||
    rawDiscount === undefined ||
    rawDiscount === ''
      ? null
      : Number(rawDiscount);

  const hasDiscount = hasOriginal &&
    Number.isFinite(discount) &&
    discount >= 0 &&
    discount < original;

  return {
    original:hasOriginal ? original : null,
    discount:hasDiscount ? discount : null,
    final:hasDiscount ? discount : (hasOriginal ? original : null),
    saving:hasDiscount ? original-discount : 0,
    hasDiscount
  };
}

/* السعر النهائي للخدمة */
function getServicePrice(service){
  return getServicePricing(service).final;
}

function money(value){
  return Number(value).toLocaleString('en-US');
}

