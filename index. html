$('offerForm').addEventListener('submit',async e => {
  e.preventDefault();
  const button = e.submitter;
  const name = $('offerName').value.trim();
  const price = Number($('offerPrice').value);
  const discount = Number($('offerDiscount').value);
  const description = $('offerDescription').value.trim();
  const file = $('offerImage').files[0];

  if(!name || !file || !Number.isFinite(price) || !Number.isFinite(discount) ||
     price <= 0 || discount < 0 || discount >= price){
    alert('راجع بيانات العرض والسعر والصورة. يجب أن يكون سعر الخصم أقل من السعر الأصلي.');
    return;
  }

  button.disabled = true;
  try{
    const image = await uploadImage(file,'offer');
    const updated = [...offers,{name,price,discount,description,image}];
    await saveSetting('salon_offers',updated);
    offers = updated;
    e.target.reset();
    renderOffers();
    alert('تم نشر العرض بنجاح.');
  }catch(err){
    alert('تعذر نشر العرض: '+err.message);
  }finally{
    button.disabled = false;
  }
});

async function removeOffer(index){
  if(!confirm('هل تريد حذف العرض؟')) return;
  const oldOffers = [...offers];
  offers.splice(index,1);
  try{
    await saveSetting('salon_offers',offers);
    renderOffers();
  }catch(err){
    offers = oldOffers;
    renderOffers();
    alert(err.message);
  }
}

